generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  location  String?
  salaryMin Int?
  salaryMax Int?
  jobUrl    String?
  source    String?
  status    ApplicationStatus @default(WISHLIST)
  priority  Int?
  appliedAt DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  contacts  Contact[]
  timeline  StageEvent[]
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model StageEvent {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  at            DateTime           @default(now())
  note          String?

  @@index([applicationId, at])
}

model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  role          String?
  email         String?
  linkedin      String?

  @@index([applicationId])
}

model Reminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueAt         DateTime
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([applicationId, dueAt])
  @@index([dueAt, done])
}
