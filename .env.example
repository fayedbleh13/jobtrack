# Copy this file to `.env` before running locally:  cp .env.example .env

# --- Database ---
# Local (host machine) development:
DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public"
# NOTE: docker-compose overrides the host to `db` internally.

# --- API (NestJS) ---
API_PORT=4000
JWT_SECRET="dev-only-secret-change-me"
WEB_ORIGIN="http://localhost:3000"
# Set to "true" only when serving over HTTPS. Secure cookies are dropped over plain http
# on hosts that are not localhost, which would silently break sign-in.
COOKIE_SECURE="false"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
# Leave empty locally. When the web app and API are on different hosts, set
# NEXT_PUBLIC_API_URL="/graphql" and point this at the API's public URL so Next proxies
# the request. That keeps the auth cookie first-party and removes the need for CORS.
API_PROXY_URL=""
