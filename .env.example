# Copy this file to `.env` before running locally:  cp .env.example .env

# --- Database ---
# Local (host machine) development:
DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public"
# NOTE: docker-compose overrides the host to `db` internally.

# --- API (NestJS) ---
API_PORT=4000
JWT_SECRET="dev-only-secret-change-me"
WEB_ORIGIN="http://localhost:3000"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
